{
  "name": "slack-quick-service-status",
  "version": "0.1.0",
  "private": true,
  "description": "Slack /status command that reports GitHub and Claude service health",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "preview": "node --experimental-strip-types scripts/preview.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ci:lint": "tsc --noEmit && vitest run"
  },
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
